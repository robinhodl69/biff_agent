# ============================================================
# Coinbase CDP v2 - Server Wallet
# ============================================================
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# ============================================================
# Network
# ============================================================
NETWORK_ID=base-sepolia

# ============================================================
# Wallet Strategy
# ============================================================
# Optional: Fixed address to reuse an existing wallet (production)
WALLET_ADDRESS=
# Optional: Idempotency Key (UUID v4) to prevent duplicates in dev
WALLET_IDEMPOTENCY_KEY=

# ============================================================
# Oracles
# ============================================================
CHAINLINK_WETH_USD_FEED=0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1

# ============================================================
# LLM
# ============================================================
LLM_PROVIDER=anthropic                    # anthropic | openai
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514

# ============================================================
# LangSmith — Agent Observability
# ============================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=biff

# ============================================================
# Tenderly — On-Chain Monitoring (optional)
# ============================================================
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_ID=
TENDERLY_PROJECT_ID=

# ============================================================
# Agent Config
# ============================================================
MIN_USDC_BALANCE=10                       # USDC threshold to trigger borrowing
MAX_LTV=70                                # Maximum Loan-to-Value before adding collateral
LOAN_WARN_DAYS=3                          # Days before expiry to trigger repayment
AGENT_LOOP_INTERVAL_MIN=5                 # Minutes between agent cycles

# ============================================================
# Admin Panel
# ============================================================
ADMIN_SECRET=change-me-to-a-strong-secret

# ============================================================
# API Server
# ============================================================
API_PORT=3000

# ============================================================
# Protocol Contracts (Base Sepolia)
# ============================================================
LENDING_INTENT_MATCHER=0xF351eDF229ded7E2e2b23E44c70e9964CbA91B2E
PRICE_ORACLE=0x71020b939b1f0988b2d93c2d930fea5b370203a5

# Optional
# FLOE_API_URL=https://api.floe.finance/v1
