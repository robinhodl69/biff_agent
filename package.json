{
  "name": "biff-agent",
  "version": "1.0.0",
  "description": "Biff Agent - Autonomous Financial Agent on Base",
  "main": "dist/agent.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/agent.ts",
    "start": "node dist/agent.js",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' && prettier --check 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix && prettier --write 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "wallet:address": "ts-node scripts/get-wallet-address.ts"
  },
  "keywords": [
    "agent",
    "base",
    "cdp",
    "langgraph",
    "x402",
    "lending"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@coinbase/agentkit": "^0.10.4",
    "@coinbase/cdp-langchain": "^0.0.15",
    "@langchain/anthropic": "^0.3.34",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "langsmith": "^0.5.15",
    "winston": "^3.13.0",
    "x402-express": "^0.1.0",
    "x402-fetch": "^0.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
