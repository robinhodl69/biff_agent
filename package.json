{
  "name": "biff-monorepo",
  "private": true,
  "workspaces": [
    "agent",
    "frontend"
  ],
  "scripts": {
    "dev:agent": "npm run dev --workspace=agent",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "npm run dev:agent",
    "test": "npm run test --workspace=agent",
    "test:watch": "npm run test:watch --workspace=agent",
    "build": "npm run build --workspace=frontend && npm run build --workspace=agent",
    "build:agent": "npm run build --workspace=agent",
    "build:frontend": "npm run build --workspace=frontend",
    "start:prod": "node agent/dist/agent.js",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "wallet:address": "npm run wallet:address --workspace=agent"
  }
}
